# ── FırsatVakti Ortam Değişkenleri ──────────────────────────────
# Bu dosyayı .env olarak kaydedin, asla GitHub'a yüklemeyin!

# Uygulama
SECRET_KEY=firsatvakti-gizli-anahtar-2024
DB_PATH=firsatvakti.db
SITE_URL=https://firsatvakti.com

# Telegram Kanal Botu
# BotFather'dan alın: @BotFather → /newbot
TG_CHANNEL_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TG_CHANNEL_ID=@firsatvakti     # veya -1001234567890

# Affiliate Tag'ler
AMAZON_TAG=firsatvakti-21       # Amazon Associates'den alın
TRENDYOL_AFF=firsatvakti        # Trendyol Affiliate'den alın
N11_AFF=firsatvakti             # N11 Partner'dan alın
HB_AFF=firsatvakti              # Hepsiburada Affiliate'den alın

# ── E-posta (Şifre Sıfırlama) ────────────────────────────────
# Gmail için: https://myaccount.google.com/apppasswords (2FA açık olmalı)
# Yandex: smtp.yandex.com, port 587
# Zoho: smtp.zoho.eu, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=firsatvakti@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # Gmail App Password
SMTP_FROM=FırsatVakti <firsatvakti@gmail.com>

# ── Scraper Servisi (VPS ayrımı için) ────────────────────────
# VPS'de çalışan scraper servisinin adresi (boş bırakılırsa lokal çalışır)
SCRAPER_SERVICE_URL=http://192.168.1.x:8001
SCRAPER_SERVICE_KEY=gizli-scraper-api-anahtari
