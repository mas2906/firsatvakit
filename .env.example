# ── FırsatVakti Ortam Değişkenleri ──────────────────────────────
# Bu dosyayı .env olarak kaydedin, asla GitHub'a yüklemeyin!

# Uygulama
SECRET_KEY=GUCLU_RASTGELE_ANAHTAR_GIRIN   # python3 -c "import secrets;print(secrets.token_hex(32))"
DB_PATH=firsatvakti.db
SITE_URL=https://firsatvakti.com

# ── Telegram: Admin Botu (onay bildirimleri → sana özel gelir) ──
# Telegram'da @userinfobot'a /start yaz → kendi chat ID'ini öğren
TG_ADMIN_TOKEN=TELEGRAM_ADMIN_BOT_TOKENI_BURAYA
TG_ADMIN_CHAT_ID=                    # Senin Telegram kullanıcı ID'in (sayı)

# ── Telegram: Kanal Botu (onaylanan fırsatlar → @firsatvakti1) ─
TG_CHANNEL_TOKEN=TELEGRAM_KANAL_BOT_TOKENI_BURAYA
TG_CHANNEL_ID=@firsatvakti1

# Affiliate Tag'ler
# Amazon Associates'den alın:
AMAZON_TAG=firsatvakti-21
# Trendyol Affiliate'den alın:
TRENDYOL_AFF=firsatvakti
# N11 Partner'dan alın:
N11_AFF=firsatvakti
# Hepsiburada Affiliate'den alın:
HB_AFF=firsatvakti

# ── E-posta (Şifre Sıfırlama) ────────────────────────────────
# Gmail için: https://myaccount.google.com/apppasswords (2FA açık olmalı)
# Yandex: smtp.yandex.com, port 587
# Zoho: smtp.zoho.eu, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=EPOSTA_ADRESINIZ@gmail.com
SMTP_PASS=GMAIL_APP_SIFRENIZ           # Gmail App Password (boşluksuz 16 karakter)
SMTP_FROM=FırsatVakti <EPOSTA_ADRESINIZ@gmail.com>

# ── WhatsApp Kanalı ──────────────────────────────────────────
# WhatsApp kanalının paylaşım linki (https://whatsapp.com/channel/...)
WA_CHANNEL_URL=

# ── WhatsApp Business API (opsiyonel — onaylanan fırsatı otomatik gönderir) ──
# Tanımlı değilse whatsapp_pub.py sessizce atlar (uygulama etkilenmez).
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TO_NUMBER=

# ── Claude AI (Otomatik Makale Yazımı) ───────────────────────
# https://console.anthropic.com/api-keys adresinden alın
ANTHROPIC_API_KEY=sk-ant-ANTHROPIC_API_ANAHTARINIZ

# ── Scraper Servisi (VPS ayrımı için) ────────────────────────
# VPS'de çalışan scraper servisinin adresi (boş bırakılırsa lokal çalışır)
SCRAPER_SERVICE_URL=http://VPS_IP_ADRESI:8001
SCRAPER_SERVICE_KEY=GIZLI_SCRAPER_API_ANAHTARI
FRONTEND_WEBHOOK_KEY=GIZLI_WEBHOOK_ANAHTARI

# ── Google Search Console Doğrulama ─────────────────────────
GOOGLE_SITE_VERIFICATION=google_DOGRULAMA_DOSYA_ADI.html

# ── Merkezi Proxy (opsiyonel — tanımlı değilse scraper doğrudan bağlanır) ─
# Trendyol, Amazon, Hepsiburada, N11 için crawlee PlaywrightCrawler'a otomatik
# bağlanır (scrapers/crawlee_base.py:_build_proxy_configuration). Residential
# proxy (Decodo, IPRoyal, Bright Data) önerilir — datacenter proxy/VPN IP'leri
# platformlar tarafından tanınıp bloklanabilir.
#
# Seçenek 1 — host/kullanıcı/şifre/port ayrı ayrı:
PROXY_HOST=gate.decodo.com
PROXY_USER=user-spzptrnarb-country-tr
PROXY_PASS=PROXY_SIFRENIZ
PROXY_PORT=10001
#
# Seçenek 2 — tek satır tam URL (yerel VPN/SOCKS için, PROXY_HOST'tan öncelikli):
# LOCAL_PROXY=socks5://127.0.0.1:1080

# ── Hepsiburada Proxy (eski — artık PROXY_* kullanılıyor) ────
HB_PROXY_HOST=gate.decodo.com
HB_PROXY_USER=user-spzptrnarb-country-tr
HB_PROXY_PASS=PROXY_SIFRENIZ
